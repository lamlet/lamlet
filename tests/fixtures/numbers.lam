Numeric domains, Euclidean division, and Float formatting.
$[Import* std]
${+ 0.1 0.2}
expect: 0.30000000000000004
${- {- {- 1 2} 3} 4}
expect: -8
${div -7 -2} ${% -7 -2} ${div 7 -2} ${% 7 -2}
expect: 4
expect: 1
expect: -3
expect: 1
${min 2.5 {min 1.5 3.0}} ${max -1 -5}
expect: 1.5
expect: -1
${float 9007199254740993}
expect: 9007199254740992.0
${/ 1.0 3.0}
expect: 0.3333333333333333
${neg 0.0}
expect: 0.0
${* 1e200 1e100}
expect: 1e300
$[# minInt -9223372036854775808]
$minInt
expect: -9223372036854775808
${% minInt 7}
expect: 6
${< -1 0} ${<= 1 1} ${>= 3 3} ${> 1 1}
expect: true
expect: true
expect: true
expect: false
${abs 0} ${abs -0.5}
expect: 0
expect: 0.5
${+ 1.0 0.5} ${abs {- 2.5 3.0}}
expect: 1.5
expect: 0.5
