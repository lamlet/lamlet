[latex "..."] formulas: raw backslashes, holes, escaping of inserted Strings, and the Latex type.
$[Import* std]
$[latex "\frac{1}{2} + \nabla"]
expect: {latex: "\\frac{1}{2} + \\nabla"}
$[# a [latex "x^2"]]
$[latex "\sqrt{$a + ${+ 1 2}}"]
expect: {latex: "\\sqrt{x^2 + 3}"}
$[# label "a_b {c} 50% \\ ^ ~"]
${latexSource [latex "$label"]}
expect: "a\\_b \\{c\\} 50\\% \\text{\\textbackslash} \\text{\\textasciicircum} \\text{\\textasciitilde}"
${latexSource [latex "$$\alpha"]}
expect: "$\\alpha"
${= [latex "x"] [latex "x"]} ${.latex {: [latex "x"] Latex}}
expect: true
expect: "x"
${latexSource [latex "
    \begin{aligned}
      y &= $a
    \end{aligned}
    "]}
expect: "\\begin{aligned}\n  y &= x^2\n\\end{aligned}\n"
