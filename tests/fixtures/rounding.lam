Rounding Floats to Ints, and fixed-precision text for display and speech.
$[Import* std]
${floor 2.7} ${floor -2.1} ${ceil 2.1} ${ceil -2.7} ${truncate -2.7}
expect: 2
expect: -3
expect: 3
expect: -2
expect: -2
${round 2.5} ${round -2.5} ${round 2.4999}
expect: 3
expect: -3
expect: 2
${fixed 0.5019607843137255 2} ${fixed 2.0 0} ${fixed 1234.5 3} ${fixed -0.001 2}
expect: "0.50"
expect: "2"
expect: "1234.500"
expect: "0.00"
${fixed 0.125 2} ${fixed 2.675 2}
expect: "0.12"
expect: "2.67"
$[f "about ${fixed {/ 1.0 3.0} 3} seconds"]
expect: "about 0.333 seconds"
${round {: 0.0 Float}}
expect: 0
